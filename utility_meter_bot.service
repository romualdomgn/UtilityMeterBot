[Unit]
Description=Telegram Utility Meter Bot v.2 (Single-Message UI)
After=network.target

[Service]
Type=simple
User=utility_meter_bot_user
Group=utility_meter_bot_user
WorkingDirectory=/opt/utility_meter_bot
ExecStart=/opt/utility_meter_bot/venv/bin/python /opt/utility_meter_bot/bot.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/utility_meter_bot/data /opt/utility_meter_bot/backups /opt/utility_meter_bot/exports

[Install]
WantedBy=multi-user.target